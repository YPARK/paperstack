{
  "manifest_version": 3,
  "name": "paperstack",
  "version": "0.1.0",
  "description": "Add the paper on this page, with its PDF fetched here, to paperstack (paperstack serve, on this machine).",
  "action": {
    "default_title": "Add to paperstack",
    "default_icon": "icon.png"
  },
  "icons": { "128": "icon.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "notifications"],
  "host_permissions": ["<all_urls>"]
}
