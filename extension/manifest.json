{
  "manifest_version": 3,
  "name": "paperstack",
  "version": "0.2.0",
  "description": "Add the paper on this page, with its PDF fetched here, to paperstack (paperstack serve, on this machine).",
  "key": "",
  "action": {
    "default_title": "Add to paperstack",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
